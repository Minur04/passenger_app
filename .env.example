# ========================================================
# SmartRide - Environment Configuration Reference
# ========================================================

# --------------------------------------------------------
# PassengerApp Client Variables (Exposed via EXPO_PUBLIC_)
# --------------------------------------------------------
EXPO_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
EXPO_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
EXPO_PUBLIC_ANDROID_MAPS_API_KEY=your_android_maps_api_key_here
EXPO_PUBLIC_MAPTILER_API_KEY=your_maptiler_api_key_here

# Supabase Storage Configuration (Profile Photos & Document Storage)
# Uses anonymous public key safe for mobile client
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
EXPO_PUBLIC_SUPABASE_PROFILE_BUCKET=profile-photos

# PayHere Sandbox Merchant Configuration
# Merchant ID is public and identifies the merchant account
EXPO_PUBLIC_PAYHERE_MERCHANT_ID=1238320
# Optional: Publicly accessible notification webhook URL
EXPO_PUBLIC_PAYHERE_NOTIFY_URL=https://your-domain.com/api/payhere/notify

# --------------------------------------------------------
# Backend-Only Variables (NEVER expose to client / PassengerApp)
# NEVER prefix with EXPO_PUBLIC_
# --------------------------------------------------------
PORT=3000
PAYHERE_MERCHANT_SECRET=your_backend_payhere_merchant_secret_here
PAYHERE_NOTIFY_URL=https://your-public-server.com/api/payhere/notify
PAYHERE_RETURN_URL=https://smartride.lk/payment/success
PAYHERE_CANCEL_URL=https://smartride.lk/payment/cancel
FIREBASE_SERVICE_ACCOUNT=your_firebase_service_account_json_or_path
